{
  "name": "capturekit",
  "version": "0.0.1",
  "description": "Autonomous visual capture for shipped software. CLI-first, CI-native.",
  "keywords": [
    "screenshot",
    "capture",
    "playwright",
    "headless",
    "gallery",
    "ci"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "capturekit": "./bin/capturekit.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "docs"
  ],
  "scripts": {
    "capturekit": "node bin/capturekit.mjs",
    "doctor": "node bin/capturekit.mjs doctor",
    "fixture": "node scripts/serve-fixtures.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "15.0.0",
    "fast-glob": "^3.3.3",
    "ffmpeg-static": "^5.3.0",
    "p-limit": "7.3.3",
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^61.7.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.0.5"
  }
}
